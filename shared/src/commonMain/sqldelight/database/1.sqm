-- Migration to schema version 2: multiple recordings per note.

CREATE TABLE noteRecordingEntity(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    note_id INTEGER NOT NULL REFERENCES notesEntity(id) ON DELETE CASCADE,
    file_path TEXT NOT NULL,
    transcription TEXT NOT NULL DEFAULT '',
    duration_ms INTEGER NOT NULL DEFAULT 0,
    position INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

-- Move the legacy single recording (notesEntity.recording_path) into the new table.
INSERT INTO noteRecordingEntity(note_id, file_path, transcription, duration_ms, position, created_at)
SELECT id, recording_path, '', 0, 0, created_at
FROM notesEntity
WHERE recording_path != '';
